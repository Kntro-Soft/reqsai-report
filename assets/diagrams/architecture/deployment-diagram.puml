@startuml deployment-diagram
!include ../styles/reqsai-palette.puml

skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor $REQSAI_ARROW
skinparam ArrowFontColor $REQSAI_NEUTRAL_800
skinparam ArrowFontSize 11

skinparam node {
  BackgroundColor $REQSAI_NEUTRAL_100
  BorderColor     $REQSAI_NEUTRAL_600
  FontColor       $REQSAI_NEUTRAL_800
  FontSize        12
  FontStyle       bold
}

skinparam artifact {
  BackgroundColor $REQSAI_BLUE_700
  BorderColor     $REQSAI_BLUE_900
  FontColor       #FFFFFF
  FontSize        11
}

skinparam database {
  BackgroundColor $REQSAI_TEAL_800
  BorderColor     $REQSAI_TEAL_900
  FontColor       #FFFFFF
  FontSize        11
}

skinparam component {
  BackgroundColor $REQSAI_NAVY_800
  BorderColor     "#1A3A5C"
  FontColor       #FFFFFF
  FontSize        11
}


title Deployment Diagram -- ReqsAI (C4 Level 4)

' ────────────────────────────────────────────────────────────────────
' CLIENT SIDE
' ────────────────────────────────────────────────────────────────────
node "Mobile Devices  [iOS / Android]" as mobileDevices {
  node "User Smartphone" as smartphone {
    artifact "Mobile App\n[Flutter Engine]" as mobileApp
  }
}

node "User Workstations  [Windows / macOS / Linux]" as workstations {
  node "Web Browser  [Browser Runtime]" as browser {
    artifact "Web Application\n[Angular SPA]" as webApp
  }
}

' ────────────────────────────────────────────────────────────────────
' AWS GLOBAL / EDGE  (DNS + CDN son servicios globales, sin region)
' ────────────────────────────────────────────────────────────────────
node "AWS Global  [DNS + Edge Network]" as awsGlobal {
  artifact "Amazon Route 53\n[Hosted Zone: tamci.app]\napp.tamci.app -> CloudFront\napi.tamci.app -> ALB (solo como origen)" as route53
  artifact "AWS Certificate Manager\n[ACM]\nCertificados TLS:\napi.tamci.app, app.tamci.app" as acm

  node "Amazon CloudFront Distribution  [app.tamci.app]" as cdn {
    artifact "CloudFront Function\n[Viewer Request]\nRechaza Host != app.tamci.app\n(bloquea el dominio *.cloudfront.net\ny cualquier acceso directo)" as cfFunction
    artifact "Cache Behaviors\nDefault /* -> S3 (SPA estatico)\n/api/*, /ws/* -> ALB (sin cache)" as cfBehaviors
  }
}

' ────────────────────────────────────────────────────────────────────
' AWS North America  (us-east-1 — Virginia) — VPC
' ────────────────────────────────────────────────────────────────────
node "AWS North America  [AWS Region us-east-1 (Virginia) — VPC]" as awsNorthAmerica {

  node "Public Subnets" as publicSubnets {
    artifact "Application Load Balancer\n[HTTPS :443, cert api.tamci.app]\nHTTP :80 -> redirect HTTPS\nSecurity Group: solo trafico desde\nCloudFront (managed prefix list)" as alb
    artifact "NAT Gateway" as nat
  }

  node "Private Subnets" as privateSubnets {
    node "ECS Cluster  [AWS ECS + Fargate]" as ecsCluster {
      component "ReqsAI Backend Service\n[Java 25 + Spring Boot 4 / Docker]\n1 vCPU / 2 GB — Fargate\n\nModulos: IAM · Billing · Workspace\nRequirement Discovery · Integration Gateway\n\nSecurity Group: solo trafico desde el ALB" as backend
    }
  }

  node "Database Subnets" as dbSubnets {
    database "AWS RDS — PostgreSQL + pgvector\n[db.t4g.micro, single-AZ, cifrado]\nSecurity Group: solo trafico\ndesde las tareas ECS" as db
  }
}

' ────────────────────────────────────────────────────────────────────
' AWS MANAGED SERVICES (soporte al runtime, sin servidor propio)
' ────────────────────────────────────────────────────────────────────
node "AWS Managed Services  [sin infraestructura propia que administrar]" as awsManaged {
  artifact "Amazon ECR\n[Registro de imagenes Docker]" as ecr
  artifact "AWS Secrets Manager\n[JWT keys, credenciales SMTP,\nAPI keys de IA, password de RDS]" as secretsManager
  artifact "Amazon CloudWatch Logs\n[Logs de aplicacion via awslogs]" as cloudwatch
  artifact "Amazon S3\n[Bucket privado — build Angular\nsolo legible via CloudFront OAC]" as s3web
}

' ────────────────────────────────────────────────────────────────────
' RELATIONS
' ────────────────────────────────────────────────────────────────────
' Web: pasa por CloudFront
webApp --> cdn    : "HTTPS\napp.tamci.app"
cdn    --> webApp : "Sirve SPA estatico\n(Edge Locations)"

' Mobile: tambien pasa por CloudFront -- el ALB no acepta trafico\ndirecto (Security Group solo confia en CloudFront)
mobileApp --> cdn : "Llamadas API\nHTTPS / REST + WebSocket\napp.tamci.app/api, /ws"

cdn --> s3web : "Origen 1: assets estaticos\n(Origin Access Control)"
cdn --> alb   : "Origen 2: /api/*, /ws/*\nHTTPS, SNI = api.tamci.app"

route53 ..> cdn : "resuelve\napp.tamci.app"
route53 ..> alb : "resuelve\napi.tamci.app"
acm     ..> cdn : "certificado TLS"
acm     ..> alb : "certificado TLS"

alb --> backend : "Forward\nHTTP :8080"

' Persistencia y soporte runtime
backend    --> db             : "Reads and writes\nJDBC / JPA"
backend    --> secretsManager : "Lee secretos en el arranque\n(inyectados como env vars)"
backend    --> cloudwatch     : "Logs stdout/stderr\n(awslogs driver)"
backend    ..> nat            : "Salida a internet\n(APIs externas: LLM, STT, SMTP)"
ecsCluster ..> ecr            : "Pull de la imagen\nal iniciar la tarea"

legend bottom right
  |= Elemento                                                              |= Descripcion                              |
  |<back:$REQSAI_NEUTRAL_100><color:$REQSAI_NEUTRAL_800><b> Nodo </b></color></back>        | Infraestructura / entorno de despliegue   |
  |<back:$REQSAI_BLUE_700><color:#FFFFFF><b> Artefacto </b></color></back>                  | Servicio administrado o desplegado        |
  |<back:$REQSAI_NAVY_800><color:#FFFFFF><b> Componente </b></color></back>                 | Modulo de aplicacion (Spring Modulith)    |
  |<back:$REQSAI_TEAL_800><color:#FFFFFF><b> Base de datos </b></color></back>              | Almacenamiento relacional (PostgreSQL)    |
  | ->                                                                     | Comunicacion de trafico / datos           |
  | ..>                                                                    | Resolucion DNS / certificado / soporte    |
endlegend

@enduml
